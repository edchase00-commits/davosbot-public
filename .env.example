GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REWRITE_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Gemini spend controls. Set GEMINI_ENABLED=false and restart to hard-disable
# Gemini text/tool/image calls. Daily budget/alert values are local estimates.
GEMINI_ENABLED=true
GEMINI_DAILY_BUDGET_USD=1.00
GEMINI_DAILY_ALERT_USD=0.25
GEMINI_BUDGET_ALERT_COOLDOWN_MINUTES=30
OPENAI_API_KEY=
# Optional image feature controls. IMAGE_PROVIDER allowed values:
# auto, openai, gemini, local, disabled. auto chooses local, then Gemini, then OpenAI.
IMAGE_PROVIDER=auto
IMAGE_SCAN_PROVIDER=auto
LOCAL_IMAGE_ENDPOINT=
LOCAL_IMAGE_TIMEOUT=180
# Optional local Flux/SDXL generation. The bot calls LOCAL_IMAGE_ENDPOINT.
# scripts/local_image_worker.py runs that endpoint and proxies to ComfyUI.
LOCAL_IMAGE_WORKER_HOST=127.0.0.1
LOCAL_IMAGE_WORKER_PORT=7861
LOCAL_IMAGE_POLL_SECONDS=2
IMAGE_OUTPUT_DIR=generated/images
LOCAL_IMAGE_OUTPUT_DIR=generated/images
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=exports/private/flux_workflow_api.json
FLUX_IMAGE_WIDTH=1024
FLUX_IMAGE_HEIGHT=1024
FLUX_IMAGE_STEPS=4
FLUX_IMAGE_GUIDANCE=0
FLUX_NEGATIVE_PROMPT=
# Optional OpenAI model labels. They are inactive unless OPENAI_API_KEY is set.
# Leave blank to use the code defaults.
OPENAI_VISION_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=low
# Reviewable model-routing policy labels. These are shown by `model status`
# without exposing keys. Changing them should go through `model request ...`,
# focused tests, Mini pull, and runtime smoke.
# Leave blank to let config compute labels from the active base models.
ADVANCED_TEXT_MODEL=
ADVANCED_CODE_MODEL=
ADVANCED_VISION_MODEL=
MODEL_ROUTE_SIMPLE_CHAT=
MODEL_ROUTE_TOOL_USE=
MODEL_ROUTE_HELPER_REWRITE=
MODEL_ROUTE_COMPLEX_REASONING=
MODEL_ROUTE_IMAGE_SCAN=
MODEL_ROUTE_IMAGE_GENERATION=
MODEL_ROUTE_CODE_REVIEW=
# Optional owner alert webhook. Used for critical backend/startup alerts
# independent of iMessage. Never commit a real URL. Supports generic JSON,
# Discord, Slack, and ntfy-style webhook URLs.
OWNER_ALERT_WEBHOOK_URL=
OWNER_ALERT_WEBHOOK_TIMEOUT=5
# Optional override for the private Fourth Down URL returned by `fantasy`.
# Blank uses the deployed production site built into davosbot.config.
FANTASY_DASHBOARD_URL=
# Optional secure auto-deploy watcher. Leave disabled until the Mac Mini has
# OWNER_ALERT_WEBHOOK_URL configured and this process is PM2-managed.
AUTO_DEPLOY_ENABLED=false
AUTO_DEPLOY_DRY_RUN=false
AUTO_DEPLOY_GITHUB_REPO=example/davosbot
AUTO_DEPLOY_REMOTE=origin
AUTO_DEPLOY_BRANCH=master
AUTO_DEPLOY_REQUIRE_CI=true
AUTO_DEPLOY_REQUIRED_WORKFLOW=tests
AUTO_DEPLOY_POLL_SECONDS=120
AUTO_DEPLOY_PREFLIGHT_CMD=bash scripts/validate.sh
AUTO_DEPLOY_POST_MERGE_CMD=python3 -m py_compile main.py && python3 -m compileall -q davosbot
AUTO_DEPLOY_RESTART_CMD=PATH=/opt/homebrew/bin:/usr/local/bin:$PATH pm2 restart davosbot
AUTO_DEPLOY_SELF_RESTART_CMD=PATH=/opt/homebrew/bin:/usr/local/bin:$PATH pm2 restart davosbot-autodeploy --update-env
AUTO_DEPLOY_ALERT_COOLDOWN_SECONDS=900
# Optional. If unset, scripts/auto_deploy.py falls back to authenticated gh CLI.
AUTO_DEPLOY_GITHUB_TOKEN=
TAVILY_API_KEY=
OWNER_ID=
# Required. Used to gate owner-only actions via iMessage. Never commit this value.
# Accepted forms in a message: "password: myword"  "pw: myword"  or just "myword" alone.
ADMIN_PASSWORD=
# The Apple ID the Mac Mini sends iMessages from. Group chats MUST be created
# from this identity for outbound routing to work.
MAC_MINI_APPLE_ID=<email>
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=1h
OLLAMA_KEEP_WARM_ENABLED=true
OLLAMA_KEEP_WARM_INTERVAL_SECONDS=1800
OLLAMA_KEEP_WARM_TIMEOUT=30
POLL_INTERVAL=5
# Keyless personal market tracker. Polls Mag 7 + Nasdaq/S&P from 4am-8pm ET
# on weekdays. Owner can pause/resume notifications with `market alerts off|on`.
MARKET_TRACKER_ENABLED=true
MARKET_ALERTS_ENABLED=true
MARKET_POLL_MINUTES=5
MARKET_DATA_TIMEOUT=10
MARKET_ALERT_COOLDOWN_MINUTES=90
DB_PATH=/Users/yourusername/Library/Messages/chat.db
# SMTP for sharecontact email delivery
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
